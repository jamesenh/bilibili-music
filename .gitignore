# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# 测试运行产物:落盘类用例把目录注入到 tests/_scratch/ 下(见 AGENTS.md 第 7 节,
# 不用 tempfile),每次跑测试都会重写一遍,不属于源码
tests/_scratch/

# Local UI design mockups (large binaries, deliberately not tracked)
ui设计图/

# Rust/Tauri迁移的依赖、构建输出与自动生成的权限schema不进入源码提交。
/bili-music-tauri/node_modules/
/bili-music-tauri/dist/
/bili-music-tauri/src-tauri/target/
/bili-music-tauri/src-tauri/gen/schemas/
/bili-music-tauri/*.tsbuildinfo

# 迁移目录只提交源码；账号会话、数据库和本地环境配置保留在设备上。
/bili-music-tauri/.env
/bili-music-tauri/.env.*
!/bili-music-tauri/.env.example
/bili-music-tauri/**/session.json
/bili-music-tauri/**/*.db
/bili-music-tauri/**/*.db-shm
/bili-music-tauri/**/*.db-wal
